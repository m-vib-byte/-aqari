{
  "version": "V198",
  "product_version": "V267",
  "required_secrets": [],
  "public_runtime_config": [
    {
      "name": "SUPABASE_PUBLIC_URL",
      "source": "public-config.js",
      "purpose": "Supabase project endpoint"
    },
    {
      "name": "SUPABASE_PUBLISHABLE_KEY",
      "source": "public-config.js",
      "purpose": "Browser-safe Supabase publishable key"
    }
  ],
  "deployment_identity": {
    "source": "Vercel managed environment",
    "required_in": ["preview", "production"],
    "fields": ["VERCEL_ENV", "VERCEL_GIT_COMMIT_SHA", "VERCEL_URL"]
  },
  "prohibited_public_values": [
    "SUPABASE_SERVICE_ROLE_KEY",
    "database passwords",
    "provider API secrets"
  ]
}
